+                    JImage(panel,new Color(.035f,.05f,.055f,.98f)); JSet(view,"panel",panel.gameObject);
+                    JImage(JRect("AmberRule",panel,Vector2.zero,new Vector2(0,1),Vector2.zero,new Vector2(3,0)),Amber);
