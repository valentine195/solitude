 from PIL import Image
 
 
+RESAMPLING_FILTERS = {
+    "nearest": Image.Resampling.NEAREST,
+    "lanczos": Image.Resampling.LANCZOS,
+}
+PIXEL_ART_STYLES = {"pixel_art", "retro_pixel"}
+INTEGER_SCALE_TOLERANCE = 1e-6
+
+
+def resampling_filter(name: str) -> Image.Resampling:
+    try:
+        return RESAMPLING_FILTERS[name]
+    except KeyError as exc:
+        raise ValueError(f"Unknown resampling strategy '{name}'.") from exc
+
+
+def is_integer_scale(scale: float, tolerance: float = INTEGER_SCALE_TOLERANCE) -> bool:
+    """Return True for integer upscales or reciprocal-integer downscales."""
+    if scale <= 0:
+        return False
+    if math.isclose(scale, 1.0, rel_tol=tolerance, abs_tol=tolerance):
+        return True
+    if scale > 1.0:
+        return math.isclose(scale, round(scale), rel_tol=tolerance, abs_tol=tolerance)
+    inverse = 1.0 / scale
+    return math.isclose(inverse, round(inverse), rel_tol=tolerance, abs_tol=tolerance)
+
+
+def validate_integer_scale(scale: float, context: str) -> None:
+    if is_integer_scale(scale):
+        return
+    raise ValueError(
+        f"{context} requires integer pixel scaling, but computed scale is {scale:.6f}. "
+        "Use source art and output dimensions that permit an integer upscale or reciprocal-integer "
+        "downscale, adjust --fit-scale, or omit --require-integer-scale for non-production processing."
+    )
+
+
