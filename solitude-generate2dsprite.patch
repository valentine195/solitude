+def resolve_cell_dimensions(
+    args: argparse.Namespace,
+    rows: int,
+    cols: int,
+) -> tuple[int, int]:
+    """Resolve rectangular output cell dimensions while preserving --cell-size compatibility."""
+    if args.cell_size is not None and (args.cell_width is not None or args.cell_height is not None):
+        raise ValueError("Use either --cell-size or --cell-width/--cell-height, not both.")
+    if (args.cell_width is None) != (args.cell_height is None):
+        raise ValueError("Rectangular cells require both --cell-width and --cell-height.")
+
+    if args.cell_width is not None and args.cell_height is not None:
+        cell_width = int(args.cell_width)
+        cell_height = int(args.cell_height)
+    elif args.cell_size is not None:
+        cell_width = cell_height = int(args.cell_size)
+    else:
+        default_size = 96 if (rows, cols) == (4, 4) else 128
+        cell_width = cell_height = default_size
+
+    if cell_width <= 0 or cell_height <= 0:
+        raise ValueError("Output cell dimensions must be greater than zero.")
+    return cell_width, cell_height
+
+
+def resolve_processing_contract(args: argparse.Namespace) -> tuple[str, bool]:
+    """Resolve resampling and pixel-art safety rules for one processing run."""
+    pixel_art = bool(args.pixel_art or args.art_style in PIXEL_ART_STYLES)
+    resampling = args.resampling or ("nearest" if pixel_art else "lanczos")
+    if pixel_art and resampling != "nearest":
+        raise ValueError(
+            "Pixel-art processing requires nearest-neighbor resampling. "
+            "Remove the explicit --resampling value or use --resampling nearest."
+        )
+    return resampling, pixel_art
+
